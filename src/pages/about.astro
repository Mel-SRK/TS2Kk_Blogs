---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathTo, siteProfile } from '../lib/site';
import '../styles/reading.css';

const focusAreas = [
  { title: 'Binary Exploitation', detail: '栈、堆与 ROP', topics: 'Stack · Heap · ROP' },
  { title: 'Reverse Engineering', detail: '虚拟机指令与程序混淆', topics: 'VM · Obfuscation · Z3' },
  { title: 'Linux Internals', detail: '可执行文件、进程和系统调用', topics: 'ELF · ptrace · Syscalls' },
  { title: 'Tooling & Automation', detail: '调试工具开发与脚本自动化', topics: 'C · Python · GDB' },
];
const toolchain = ['x86_64 Linux', 'GDB / pwndbg', 'IDA / Binary Ninja', 'pwntools', 'Unicorn', 'Z3', 'Obsidian', 'CMake'];
---

<BaseLayout title="关于我" active="about">
  <div class="container reading-page about-page">
    <header class="reading-heading about-heading">
      <img
        class="about-portrait"
        src={pathTo('images/ts2kk-avatar-216.webp')}
        srcset={`${pathTo('images/ts2kk-avatar-144.webp')} 144w, ${pathTo('images/ts2kk-avatar-216.webp')} 216w`}
        sizes="(max-width: 30rem) 4rem, 6.75rem"
        alt=""
        width="216"
        height="216"
        decoding="async"
      />
      <div>
        <h1>关于 {siteProfile.name}</h1>
        <p class="about-topics">{siteProfile.bio}</p>
      </div>
    </header>

    <div class="reading-prose about-prose">
      <p>我在这里写技术文章，也会整理做过的 CTF 题。题解来自我的 Obsidian 笔记，以 Pwn 为主，也有逆向、Web 和密码学。</p>

      <nav class="about-links about-contact" aria-label="联系方式">
        <a class="reading-button animated-underline" href={siteProfile.githubUrl}>GitHub @{siteProfile.githubHandle}</a>
        <a class="reading-button animated-underline" href={`mailto:${siteProfile.email}`}>{siteProfile.email}</a>
      </nav>

      <nav class="about-links" aria-label="阅读与订阅">
        <a class="reading-button" href={pathTo('posts/')}>全部文章</a>
        <a class="reading-button" href={`${pathTo('posts/')}?category=${encodeURIComponent('技术')}`}>技术博客</a>
        <a class="reading-button" href={pathTo('posts/?category=Write-ups')}>CTF 题解</a>
        <a class="reading-button reading-button-secondary" href={pathTo('rss.xml')}>订阅 RSS</a>
      </nav>
    </div>

    <section class="about-section" aria-labelledby="focus-areas">
      <h2 id="focus-areas">研究方向</h2>
      <ol class="focus-matrix" role="list">
        {focusAreas.map(({ title, detail, topics }, index) => (
          <li>
            <span class="focus-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 lang="en">{title}</h3>
            <p>{detail}</p>
            <span class="focus-topics" lang="en">{topics}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="about-section" aria-labelledby="toolchain">
      <h2 id="toolchain">工具链与环境</h2>
      <ul class="toolchain" role="list" lang="en">
        {toolchain.map((tool) => <li>{tool}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 62rem;
  }

  .about-heading {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2rem);
    margin-block-end: 1.8rem;
  }

  .about-heading h1 {
    font-size: clamp(1.8rem, 5vw, 3.3rem);
    text-wrap: pretty;
  }

  .about-topics {
    margin: .4rem 0 0;
    color: var(--muted);
  }

  .about-portrait {
    display: block;
    flex: none;
    width: 6.75rem;
    height: auto;
    border: 1px solid var(--strong-border);
    background: var(--panel);
  }

  .about-prose {
    padding-block-start: 1.55rem;
    border-block-start: 1px solid var(--border);
  }

  .about-prose > p {
    max-width: 38rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem 1.35rem;
    font-family: var(--font-body);
  }

  .about-contact {
    margin-block-end: .5rem;
  }

  .about-section {
    margin-block-start: clamp(2rem, 5vw, 3.25rem);
  }

  .about-section h2 {
    margin: 0 0 .85rem;
    font: 650 clamp(1.25rem, 2vw, 1.5rem)/1.4 var(--font-display);
  }

  .focus-matrix,
  .toolchain {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-matrix {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--border);
  }

  .focus-matrix li {
    display: flex;
    flex-direction: column;
    min-height: 10rem;
    padding: clamp(.85rem, 2.5vw, 1.35rem);
    background: linear-gradient(150deg, var(--blue-wash), transparent 60%), var(--surface);
  }

  .focus-number,
  .focus-topics,
  .toolchain li {
    font: 500 .75rem/1.5 var(--font-mono);
  }

  .focus-number {
    color: var(--blue-light);
  }

  .focus-matrix h3 {
    margin: .55rem 0 .25rem;
    font: 650 1.1rem/1.25 var(--font-display);
    overflow-wrap: anywhere;
  }

  .focus-matrix p {
    margin: 0 0 .55rem;
    color: var(--muted);
    font-size: .9rem;
  }

  .focus-topics {
    margin-block-start: auto;
    color: var(--accent);
  }

  .toolchain {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
  }

  .toolchain li {
    padding: .35rem .55rem;
    border: 1px solid var(--strong-border);
    background: var(--surface);
    color: var(--muted);
  }

  @media (min-width: 57rem) {
    .focus-matrix {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .about-portrait {
      width: 4rem;
    }

    .focus-matrix {
      grid-template-columns: 1fr;
    }

    .focus-matrix li {
      min-height: 0;
    }
  }
</style>
