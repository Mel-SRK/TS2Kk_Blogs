---
import { render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { accessibleDate, formatDate, getCover, getPosts, getRelatedPosts, readingMinutes } from '../../lib/posts';
import { pathTo } from '../../lib/site';
import '../../styles/reading.css';
import '../../styles/article.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1], related: getRelatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
  related: ReturnType<typeof getRelatedPosts>;
}

const { post, newer, older, related } = Astro.props;
const { title, description, pubDate, category, tags, cover } = post.data;
const { Content, headings } = await render(post);
const photo = getCover(cover);
const contents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const adjacent = [
  { label: '较新的文章', post: newer, rel: 'prev' },
  { label: '较早的文章', post: older, rel: 'next' },
];
---

<BaseLayout {title} {description} cover={photo.src} active="posts">
  <article class="container reading-page article-page" data-article-reader>
    <div class="reading-progress" aria-hidden="true" hidden data-reading-progress></div>
    <header class="reading-heading article-heading">
      <div class="article-actions">
        <a class="article-back" href={pathTo('posts/')} data-article-back>返回文章列表</a>
        {related.length > 0 && <a class="article-jump" href="#related-posts">相关文章</a>}
        <a class="article-jump article-top-link" href="#top"><span aria-hidden="true">↑</span> 回到顶部</a>
      </div>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="reading-meta">
        <time datetime={pubDate.toISOString().slice(0, 10)} aria-label={accessibleDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <a class="reading-category" href={`${pathTo('posts/')}?category=${encodeURIComponent(category)}`}>{category}</a>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)} 分钟阅读</span>
      </div>
    </header>

    {post.data.featured && cover !== 'desk' && (
      <img
        class="article-cover"
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        style={photo.position ? { objectPosition: photo.position } : undefined}
        fetchpriority="high"
      />
    )}

    <div class:list={['article-reading-grid', { 'has-contents': contents.length > 1 }]}>
      {contents.length > 1 && (
        <nav class="article-contents" aria-labelledby="article-contents-title" data-article-contents>
          <div class="article-contents-heading">
            <h2 id="article-contents-title">本文目录</h2>
            {contents.length > 7 && (
              <button class="article-contents-toggle" type="button" aria-controls="article-contents-list" aria-expanded="true" hidden data-contents-toggle>
                收起
              </button>
            )}
          </div>
          <span class="article-contents-indicator" data-contents-indicator aria-hidden="true" hidden></span>
          <ul id="article-contents-list" role="list" data-contents-list>
            {contents.map(({ depth, slug, text }) => (
              <li class:list={{ 'article-contents-subheading': depth === 3 }}>
                <a href={`#${slug}`}>{text}</a>
              </li>
            ))}
          </ul>
          <a class="article-top-link article-contents-top" href="#top"><span aria-hidden="true">↑</span> 回到顶部</a>
        </nav>
      )}

      <div class="article-main">
        <div class="reading-prose" data-article-prose>
          <Content />
        </div>
        {tags.length > 0 && (
          <ul class="article-tags" role="list" aria-label="文章标签">
            {tags.map((tag) => (
              <li><a href={`${pathTo('posts/')}?tag=${encodeURIComponent(tag)}`}>#{tag}</a></li>
            ))}
          </ul>
        )}

        {related.length > 0 && (
          <nav class="article-related" aria-labelledby="related-posts">
            <h2 id="related-posts" tabindex="-1">相关文章</h2>
            <ul role="list">
              {related.map(({ post: entry, topics }) => (
                <li>
                  <a class="blue-hover" href={pathTo(`posts/${encodeURIComponent(entry.id)}/`)}>
                    <span>{entry.data.title}</span>
                    <span class="article-related-topic">{topics.join(' · ')}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>

    {(newer || older) && (
      <nav class="article-adjacent" aria-label="相邻文章">
        {adjacent.map(({ label, post: entry, rel }) => entry && (
          <a class="blue-hover" href={pathTo(`posts/${encodeURIComponent(entry.id)}/`)} {rel}>
            <span>{label}</span>
            <strong>{entry.data.title}</strong>
          </a>
        ))}
      </nav>
    )}
    <p class="reading-visually-hidden" role="status" data-article-status></p>
    <dialog class="image-lightbox" aria-labelledby="image-lightbox-title" data-image-lightbox>
      <div class="image-lightbox-inner">
        <h2 class="reading-visually-hidden" id="image-lightbox-title">正文图片预览</h2>
        <form method="dialog">
          <button type="submit" class="image-lightbox-close" autofocus>关闭 <span aria-hidden="true">×</span></button>
        </form>
        <div class="image-lightbox-content" data-lightbox-content></div>
      </div>
    </dialog>
  </article>
</BaseLayout>

<script>
  import { enhanceArticle } from '../../scripts/article-reader';

  const article = document.querySelector<HTMLElement>('[data-article-reader]');
  if (article) enhanceArticle(article);
</script>
