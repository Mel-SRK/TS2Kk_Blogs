---
import { render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { accessibleDate, formatDate, getCover, getPosts, getRelatedPosts, readingMinutes } from '../../lib/posts';
import { pathTo } from '../../lib/site';
import '../../styles/reading.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1], related: getRelatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
  related: ReturnType<typeof getRelatedPosts>;
}

const { post, newer, older, related } = Astro.props;
const { title, description, pubDate, category, tags, cover } = post.data;
const { Content, headings } = await render(post);
const photo = getCover(cover);
const contents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const adjacent = [
  { label: '较新的文章', post: newer, rel: 'prev' },
  { label: '较早的文章', post: older, rel: 'next' },
];
---

<BaseLayout {title} {description} cover={photo.src} active="posts">
  <article class="container reading-page article-page">
    <header class="reading-heading article-heading">
      <div class="article-actions">
        <a class="article-back" href={pathTo('posts/')} data-article-back>返回文章列表</a>
        {related.length > 0 && <a class="article-jump" href="#related-posts">相关文章</a>}
      </div>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="reading-meta">
        <time datetime={pubDate.toISOString().slice(0, 10)} aria-label={accessibleDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <a class="reading-category" href={`${pathTo('posts/')}?category=${encodeURIComponent(category)}`}>{category}</a>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)} 分钟阅读</span>
      </div>
    </header>

    {post.data.featured && cover !== 'desk' && (
      <img
        class="article-cover"
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        style={photo.position ? { objectPosition: photo.position } : undefined}
        fetchpriority="high"
      />
    )}

    <div class:list={['article-reading-grid', { 'has-contents': contents.length > 1 }]}>
      {contents.length > 1 && (
        <nav class="article-contents" aria-labelledby="article-contents-title" data-article-contents>
          <h2 id="article-contents-title">本文目录</h2>
          <span class="article-contents-indicator" data-contents-indicator aria-hidden="true" hidden></span>
          <ul role="list">
            {contents.map(({ depth, slug, text }) => (
              <li class:list={{ 'article-contents-subheading': depth === 3 }}>
                <a href={`#${slug}`}>{text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="article-main">
        <div class="reading-prose">
          <Content />
        </div>
        {tags.length > 0 && (
          <ul class="article-tags" role="list" aria-label="文章标签">
            {tags.map((tag) => (
              <li><a href={`${pathTo('posts/')}?q=${encodeURIComponent(tag)}`}>#{tag}</a></li>
            ))}
          </ul>
        )}

        {related.length > 0 && (
          <nav class="article-related" aria-labelledby="related-posts">
            <h2 id="related-posts" tabindex="-1">相关文章</h2>
            <ul role="list">
              {related.map(({ post: entry, topics }) => (
                <li>
                  <a class="blue-hover" href={pathTo(`posts/${encodeURIComponent(entry.id)}/`)}>
                    <span>{entry.data.title}</span>
                    <span class="article-related-topic">{topics.join(' · ')}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>

    {(newer || older) && (
      <nav class="article-adjacent" aria-label="相邻文章">
        {adjacent.map(({ label, post: entry, rel }) => entry && (
          <a class="blue-hover" href={pathTo(`posts/${encodeURIComponent(entry.id)}/`)} {rel}>
            <span>{label}</span>
            <strong>{entry.data.title}</strong>
          </a>
        ))}
      </nav>
    )}
  </article>
</BaseLayout>

<script>
  const back = document.querySelector<HTMLAnchorElement>('[data-article-back]');

  if (back && document.referrer) {
    const previous = new URL(document.referrer);
    const archive = new URL(back.href);

    if (previous.origin === archive.origin && previous.pathname.replace(/\/$/, '') === archive.pathname.replace(/\/$/, '')) {
      back.href = `${archive.pathname}${previous.search}`;
    }
  }

  const directory = document.querySelector<HTMLElement>('[data-article-contents]');
  const indicator = directory?.querySelector<HTMLElement>('[data-contents-indicator]');

  if (directory && indicator) {
    const sections = Array.from(directory.querySelectorAll<HTMLAnchorElement>('a')).flatMap((link) => {
      const id = link.getAttribute('href')?.slice(1);
      const heading = id ? document.getElementById(id) : null;
      return heading ? [{ link, heading }] : [];
    });
    let current: HTMLAnchorElement | undefined;
    let frame: number | undefined;

    const update = () => {
      frame = undefined;
      const readingLine = Math.min(136, window.innerHeight * .23);
      let next: HTMLAnchorElement | undefined;

      for (const { link, heading } of sections) {
        if (heading.getBoundingClientRect().top > readingLine) break;
        next = link;
      }

      const scroller = document.scrollingElement;
      if (scroller && scroller.scrollTop > 0 && scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 2) {
        const visibleTarget = sections.find(({ heading }) => {
          if (!heading.matches(':target')) return false;
          const rect = heading.getBoundingClientRect();
          return rect.bottom > 0 && rect.top < window.innerHeight;
        });
        next = visibleTarget?.link ?? sections.at(-1)?.link;
      }

      const sectionChanged = current !== next;
      if (sectionChanged) {
        current?.removeAttribute('aria-current');
        next?.setAttribute('aria-current', 'location');
        current = next;
      }

      if (next) {
        const rect = next.getBoundingClientRect();
        const bounds = directory.getBoundingClientRect();
        const top = rect.top - bounds.top + directory.scrollTop;
        indicator.style.setProperty('--indicator-top', `${top + 4}px`);
        indicator.style.setProperty('--indicator-length', String(Math.max(1, rect.height - 8)));

        if (sectionChanged && directory.scrollHeight > directory.clientHeight) {
          if (rect.top < bounds.top) directory.scrollTop = top;
          if (rect.bottom > bounds.bottom) directory.scrollTop = top + rect.height - directory.clientHeight;
        }
      }
      indicator.hidden = !next;
    };

    const scheduleUpdate = () => {
      frame ??= requestAnimationFrame(update);
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(scheduleUpdate);
      observer.observe(directory);
      const list = directory.querySelector('ul');
      if (list) observer.observe(list);
      const main = document.querySelector('.article-main');
      if (main) observer.observe(main);
    }
    document.fonts?.ready.then(scheduleUpdate);
    scheduleUpdate();
  }
</script>
